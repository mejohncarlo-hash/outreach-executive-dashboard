{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "app/**/*.tsx",
    "lib/**/*.ts",
    "cloudflare/**/*.ts",
    "cloudflare/**/*.tsx",
    "cloudflare.vite.config.ts"
  ]
}
